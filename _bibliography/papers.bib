  author  = {Thomas Nelson Harvey and Hanne Dvergedal and Lars Grønvold and Yang Jin and Jørgen Ødegård and Sven Arild Korsvoll and Tim Martin Knutsen and Torgeir Rhoden Hvidsten and Simen Rød Sandve},
